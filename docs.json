{
  "$schema": "https://mintlify.com/docs.json",
  "name": "LotTech Help",
  "theme": "almond",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Using LotTech",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "introduction",
              "quickstart",
              "account/sign-up",
              "account/roles-and-permissions"
            ]
          },
          {
            "group": "Your account",
            "pages": [
              "account/email-notifications",
              "account/profile-settings"
            ]
          },
          {
            "group": "Customer conversations",
            "pages": [
              "communications/interactions",
              "communications/requests",
              "communications/customers",
              "communications/call-logs",
              "integrations/voice-agent"
            ]
          },
          {
            "group": "Orders and inventory",
            "pages": [
              "commerce/orders",
              "commerce/inventory",
              "commerce/rental-inventory",
              "commerce/custom-pricing"
            ]
          },
          {
            "group": "Reporting",
            "pages": [
              "analytics/overview",
              "analytics/interaction-metrics",
              "analytics/request-metrics"
            ]
          }
        ]
      },
      {
        "tab": "Rooftop admins",
        "groups": [
          {
            "group": "Your dealership",
            "pages": [
              "rooftop/overview",
              "rooftop/setup",
              "rooftop/team-management",
              "rooftop/business-hours",
              "rooftop/configure-voice",
              "rooftop/phone-and-transfers"
            ]
          },
          {
            "group": "Scheduling",
            "pages": [
              "integrations/google-calendar",
              "integrations/xtime",
              "integrations/dealerfx"
            ]
          },
          {
            "group": "Payments and storefront",
            "pages": [
              "commerce/stripe-setup",
              "integrations/stripe"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://dashboard.lottech.com"
    }
  },
  "redirects": [
    {
      "source": "/admin/manage-users",
      "destination": "/rooftop/team-management"
    },
    {
      "source": "/admin/manage-rooftops",
      "destination": "/rooftop/overview"
    },
    {
      "source": "/admin/onboarding",
      "destination": "/rooftop/setup"
    },
    {
      "source": "/integrations/twilio-phone-numbers",
      "destination": "/rooftop/phone-and-transfers"
    }
  ]
}
